{
  "name": "mlbb-co-pilot",
  "private": true,
  "version": "0.4.0",
  "author": "SpectralAV",
  "license": "Apache-2.0",
  "copyright": "Copyright 2026 SpectralAV",
  "scripts": {
    "dev": "concurrently -k -n BACKEND,FRONTEND -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "local-dns:status": "powershell -ExecutionPolicy Bypass -File .\\tools\\local-dns.ps1 -Action status",
    "local-dns:install": "powershell -ExecutionPolicy Bypass -File .\\tools\\local-dns.ps1 -Action install",
    "local-dns:remove": "powershell -ExecutionPolicy Bypass -File .\\tools\\local-dns.ps1 -Action remove",
    "test": "cd backend && npx tsx --test ../tests/*.test.ts",
    "build": "cd backend && npm run build && cd ../frontend && npm run build",
    "cv:status": "powershell -NoProfile -Command \"$p = 'data/cv/.venv/Scripts/python.exe'; if (Test-Path $p) { & $p backend/tools/ultralyticsVision.py status --project-root . } else { python backend/tools/ultralyticsVision.py status --project-root . }\"",
    "cv:bootstrap": "powershell -NoProfile -Command \"$p = 'data/cv/.venv/Scripts/python.exe'; if (Test-Path $p) { & $p backend/tools/prepareUltralyticsDataset.py } else { python backend/tools/prepareUltralyticsDataset.py }\"",
    "cv:prepare": "npm run cv:bootstrap",
    "cv:video:extract": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tools\\cv-video.ps1",
    "cv:train": "data\\cv\\.venv\\Scripts\\python.exe backend/tools/ultralyticsVision.py train --project-root . --device cpu --batch 4 --workers 0 --amp false",
    "cv:train:windows": "data\\cv\\.venv\\Scripts\\python.exe backend/tools/ultralyticsVision.py train --project-root . --device cpu --batch 4 --workers 0 --amp false",
    "cv:train:rocm": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tools\\cv-wsl.ps1 -Action train",
    "cv:wsl:bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tools\\cv-wsl.ps1 -Action bootstrap",
    "cv:wsl:status": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tools\\cv-wsl.ps1 -Action status",
    "cv:wsl:train": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tools\\cv-wsl.ps1 -Action train",
    "start": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
