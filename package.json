{
  "name": "mlbb-co-pilot",
  "private": true,
  "version": "0.4.0",
  "description": "Semantic tactical intelligence system for Mobile Legends: Bang Bang.",
  "main": "electron/main.cjs",
  "author": "SpectralAV",
  "license": "Apache-2.0",
  "copyright": "Copyright 2026 SpectralAV",
  "scripts": {
    "dev": "concurrently -k -n BACKEND,FRONTEND -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "desktop:dev": "concurrently -k -n BACKEND,FRONTEND,ELECTRON -c blue,green,magenta \"npm run dev:backend\" \"npm run dev:frontend\" \"node electron/wait-and-start.cjs\"",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "local-dns:status": "powershell -ExecutionPolicy Bypass -File .\\tools\\local-dns.ps1 -Action status",
    "local-dns:install": "powershell -ExecutionPolicy Bypass -File .\\tools\\local-dns.ps1 -Action install",
    "local-dns:remove": "powershell -ExecutionPolicy Bypass -File .\\tools\\local-dns.ps1 -Action remove",
    "local-proxy": "node .\\tools\\local-proxy.cjs",
    "dev:local": "concurrently -k -n BACKEND,FRONTEND,PROXY -c blue,green,magenta \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run local-proxy\"",
    "test": "cd backend && npx tsx --test ../tests/*.test.ts",
    "build": "cd backend && npm run build && cd ../frontend && npm run build",
    "cv:status": "powershell -NoProfile -Command \"$p = 'data/cv/.venv/Scripts/python.exe'; if (Test-Path $p) { & $p backend/tools/ultralyticsVision.py status --project-root . } else { python backend/tools/ultralyticsVision.py status --project-root . }\"",
    "cv:bootstrap": "powershell -NoProfile -Command \"$p = 'data/cv/.venv/Scripts/python.exe'; if (Test-Path $p) { & $p backend/tools/prepareUltralyticsDataset.py } else { python backend/tools/prepareUltralyticsDataset.py }\"",
    "cv:prepare": "npm run cv:bootstrap",
    "cv:video:extract": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tools\\cv-video.ps1",
    "cv:train": "data\\cv\\.venv\\Scripts\\python.exe backend/tools/ultralyticsVision.py train --project-root . --device cpu --batch 4 --workers 0 --amp false",
    "cv:train:windows": "data\\cv\\.venv\\Scripts\\python.exe backend/tools/ultralyticsVision.py train --project-root . --device cpu --batch 4 --workers 0 --amp false",
    "cv:train:rocm": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tools\\cv-wsl.ps1 -Action train",
    "cv:wsl:bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tools\\cv-wsl.ps1 -Action bootstrap",
    "cv:wsl:status": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tools\\cv-wsl.ps1 -Action status",
    "cv:wsl:train": "powershell -NoProfile -ExecutionPolicy Bypass -File .\\tools\\cv-wsl.ps1 -Action train",
    "cv:result:metadata": "powershell -NoProfile -Command \"$p = 'data/cv/.venv/Scripts/python.exe'; if (Test-Path $p) { & $p backend/tools/importResultScreenDataset.py --project-root . } else { python backend/tools/importResultScreenDataset.py --project-root . }\"",
    "cv:result:import:sample": "powershell -NoProfile -Command \"$p = 'data/cv/.venv/Scripts/python.exe'; if (Test-Path $p) { & $p backend/tools/importResultScreenDataset.py --project-root . --download --shuffle --max-train 500 --max-val 150 } else { python backend/tools/importResultScreenDataset.py --project-root . --download --shuffle --max-train 500 --max-val 150 }\"",
    "cv:result:import:all": "powershell -NoProfile -Command \"$p = 'data/cv/.venv/Scripts/python.exe'; if (Test-Path $p) { & $p backend/tools/importResultScreenDataset.py --project-root . --download } else { python backend/tools/importResultScreenDataset.py --project-root . --download }\"",
    "cv:result:status": "powershell -NoProfile -Command \"$p = 'data/cv/.venv/Scripts/python.exe'; if (Test-Path $p) { & $p backend/tools/resultScreenVision.py status --project-root . } else { python backend/tools/resultScreenVision.py status --project-root . }\"",
    "cv:result:train": "data\\cv\\.venv\\Scripts\\python.exe backend/tools/resultScreenVision.py train --project-root . --device cpu --batch 4 --workers 0 --amp false",
    "start": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.spectralav.mlbb-copilot",
    "productName": "MLBB Co-Pilot",
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "LICENSE",
      "NOTICE",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "backend/dist",
        "to": "backend/dist"
      },
      {
        "from": "backend/package.json",
        "to": "backend/package.json"
      },
      {
        "from": "backend/node_modules",
        "to": "backend/node_modules"
      },
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "data/cache/.gitkeep",
        "to": "data/cache/.gitkeep"
      },
      {
        "from": "data/obs",
        "to": "data/obs"
      },
      {
        "from": "data/map",
        "to": "data/map"
      },
      {
        "from": "map-runtime",
        "to": "map-runtime"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
