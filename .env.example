# MLBB Co-Pilot — copy to .env and fill locally (never commit secrets)

# Official data sync (Settings → Data Sync)
MLBB_GMS_AUTHORIZATION=

# Roboflow dataset import (optional)
ROBOFLOW_API_KEY=

# Ultralytics training runtime
ULTRALYTICS_TRAIN_RUNTIME=wsl
ULTRALYTICS_WSL_PYTHON=wsl:~/.mlbb-copilot/cv-rocm/bin/python
ULTRALYTICS_DEVICE=auto

# System 2 advisory coach
ADVISORY_COACH_ENABLED=true
ADVISORY_COACH_PROVIDER=heuristic-stub
ADVISORY_SIDECAR_URL=http://127.0.0.1:8790/advise
ADVISORY_SIDECAR_TIMEOUT_MS=5000
ADVISORY_COACH_MIN_MS=8000

# Dev-only agent debug log (backend POST /api/debug/agent-log)
MLBB_AGENT_DEBUG=0

# Training stuck detection (ms with artifacts present)
MLBB_TRAINING_STUCK_MS=300000
